shiny::runApp()
# show the exact lines Shiny references
lines <- readLines("modules/panel_module.R", warn = FALSE)
cat(sprintf("File has %d lines\n\n", length(lines)))
cat(paste0(sprintf("%4d: %s\n", 110:130, lines[110:130]), collapse = ""))
which_if <- grep("\\bif\\s*\\(", lines); print(which_if)
# 1) patch the module file in place
f <- "modules/panel_module.R"
txt <- readLines(f, warn = FALSE)
# find start of the unsafe block (line that begins with "observeEvent(")
start_idx <- grep("^\\s*observeEvent\\s*\\(", txt)
# find the matching closing "})" for that block by searching forward for a line with "})"
end_idx <- NA
if (length(start_idx) > 0) {
si <- start_idx[1]
# search forward for the first line that is exactly "    })" or "  })" or "})"
cand <- grep("^\\s*\\}\\)\\s*$", txt[si:length(txt)])
if (length(cand) > 0) end_idx <- si + cand[1] - 1
}
if (is.na(end_idx)) stop("Could not locate the observeEvent block automatically. Edit modules/panel_module.R manually.")
# replacement block (safe observe with req)
replacement <- c(
'    # --- Menus dépendants (safe) ---',
'    observe({',
'      # Wait until the inputs exist and are non-NULL/truthy',
'      req(isTruthy(input$region), isTruthy(input$mrc),',
'          isTruthy(input$municip), isTruthy(input$bv1), isTruthy(input$bv2))',
'',
'      df <- rsvl_df',
'',
'      if (input$region != "Toutes")',
'        df <- df %>% filter(MUS_NM_REG == input$region)',
'      if (input$mrc != "Toutes")',
'        df <- df %>% filter(MUS_NM_MRC == input$mrc)',
'      if (input$municip != "Toutes")',
'        df <- df %>% filter(MUS_NM_MUN == input$municip)',
'      if (input$bv1 != "Tous")',
'        df <- df %>% filter(bv_n1 == input$bv1)',
'      if (input$bv2 != "Tous")',
'        df <- df %>% filter(bv_n2 == input$bv2)',
'',
'      updateSelectizeInput(session, "mrc",',
'                           choices = c("Toutes", sort(unique(df$MUS_NM_MRC))),',
'                           selected = if (isTruthy(input$mrc)) input$mrc else "Toutes")',
'',
'      updateSelectizeInput(session, "municip",',
'                           choices = c("Toutes", sort(unique(df$MUS_NM_MUN))),',
'                           selected = if (isTruthy(input$municip)) input$municip else "Toutes")',
'',
'      updateSelectizeInput(session, "bv1",',
'                           choices = c("Tous", sort(unique(df$bv_n1))),',
'                           selected = if (isTruthy(input$bv1)) input$bv1 else "Tous")',
'',
'      updateSelectizeInput(session, "bv2",',
'                           choices = c("Tous", sort(unique(df$bv_n2))),',
'                           selected = if (isTruthy(input$bv2)) input$bv2 else "Tous")',
'',
'      updateSelectizeInput(session, "lac",',
'                           choices = sort(unique(df$nom_lac)),',
'                           selected = if (isTruthy(input$lac)) input$lac else NULL)',
'    })'
)
# perform replacement
new_txt <- c(txt[1:(start_idx[1]-1)], replacement, txt[(end_idx+1):length(txt)])
writeLines(new_txt, f)
cat("Patched", f, "— observeEvent(list(...)) replaced with guarded observe().\n")
