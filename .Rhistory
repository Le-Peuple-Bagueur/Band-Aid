normalizePath("modules/panel_module.R")
lines <- readLines("modules/panel_module.R", warn = FALSE)
start <- max(1, 110)
end <- min(length(lines), 130)
cat(sprintf("File has %d lines\n\n", length(lines)))
cat(paste0(sprintf("%4d: %s\n", start:end, lines[start:end]), collapse = ""))
which_if <- grep("\\bif\\s*\\(", lines)
if (length(which_if) == 0) {
cat("No if(...) found\n")
} else {
cat("if(...) occurrences at lines:\n")
print(which_if)
# show the first 10 occurrences with context
idx <- head(which_if, 20)
for (i in idx) cat(sprintf("%4d: %s\n", i, lines[i]))
}
shiny::runApp()
# show the exact lines Shiny references
lines <- readLines("modules/panel_module.R", warn = FALSE)
cat(sprintf("File has %d lines\n\n", length(lines)))
cat(paste0(sprintf("%4d: %s\n", 110:130, lines[110:130]), collapse = ""))
# show the if(...) occurrences and their line numbers
